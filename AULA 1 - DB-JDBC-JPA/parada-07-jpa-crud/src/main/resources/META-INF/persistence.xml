<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <!-- RESOURCE_LOCAL significa que a propria aplicacao controla begin/commit/rollback. -->
    <persistence-unit name="livraria" transaction-type="RESOURCE_LOCAL">
        <!-- Hibernate implementa as interfaces definidas pela especificacao JPA. -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Somente classes registradas como entidades podem ser persistidas. -->
        <class>br.edu.ibmec.livraria.Livro</class>
        <properties>
            <!-- Hibernate continuara usando JDBC por baixo da abstracao JPA. -->
            <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:livraria.db"/>

            <!-- SQLiteDialect adapta geracao de chaves, tipos e comandos ao SQLite. -->
            <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>

            <!-- none protege o banco pronto contra criacao ou alteracao de tabelas. -->
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>

            <!-- Estas opcoes deixam o SQL visivel e legivel durante a aula. -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
